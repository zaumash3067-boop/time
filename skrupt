// Отримуємо елементи зі сторінки
const hoursEl = document.getElementById('hours');
const minutesEl = document.getElementById('minutes');
const secondsEl = document.getElementById('seconds');

const startBtn = document.getElementById('startBtn');
const stopBtn = document.getElementById('stopBtn');

// Змінні для зберігання часу та інтервалу
let hours = 0;
let minutes = 0;
let seconds = 0;
let timerInterval = null;

// Функція для додавання нуля перед числом (наприклад, 5 -> 05)
function formatTime(time) {
    return time < 10 ? '0' + time : time;
}

// Функція оновлення таймера щосекунди
function updateTimer() {
    seconds++;

    if (seconds === 60) {
        seconds = 0;
        minutes++; // Якщо дійшло до 60 — скидаємо секунди і додаємо хвилину

        if (minutes === 60) {
            minutes = 0;
            hours++; // Якщо дійшло до 60 — скидаємо хвилини і додаємо годину
        }
    }

    // Оновлюємо текст на сторінці
    secondsEl.textContent = formatTime(seconds);
    minutesEl.textContent = formatTime(minutes);
    hoursEl.textContent = formatTime(hours);
}

// Подія при натисканні на кнопку "Старт" / "Продовжити"
startBtn.addEventListener('click', () => {
    // Перевіряємо, щоб не запустити кілька таймерів одночасно (захист від подвійного кліку)
    if (timerInterval !== null) return;

    // Запускаємо функцію updateTimer кожні 1000 мілісекунд (1 секунду)
    timerInterval = setInterval(updateTimer, 1000);

    // Змінюємо вигляд кнопок згідно з логікою
    stopBtn.style.opacity = '0.5';
    startBtn.style.opacity = '1';
});

// Подія при натисканні на кнопку "Стоп"
stopBtn.addEventListener('click', () => {
    // Якщо таймер не запущений, нічого не робимо
    if (timerInterval === null) return;

    // Зупиняємо відлік часу
    clearInterval(timerInterval);
    timerInterval = null;

    // Змінюємо прозорість кнопок і текст на "Продовжити"
    startBtn.style.opacity = '0.5';
    stopBtn.style.opacity = '1';
    startBtn.textContent = 'Продовжити';
});
